@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .

<https://ekphore.github.io/plugins/ekphore>
    a lv2:Plugin ;
    lv2:binary <@EKPHORE_LV2_BINARY@> ;
    rdfs:seeAlso <ekphore.ttl> .

<https://ekphore.github.io/plugins/ekphore#ui>
    a @EKPHORE_LV2_UI_CLASS@ ;
    ui:binary <@EKPHORE_LV2_BINARY@> ;
    rdfs:seeAlso <ekphore.ttl> .
